{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": [
    "lib/session-lifecycle/**/*.js",
    "lib/storage/**/*.js",
    "lib/state-engine/**/*.js",
    "lib/agent-adapters/codex-state-adapter.js",
    "lib/agent-adapters/workbuddy-state-adapter.js",
    "lib/codex-completion-history.js",
    "lib/runtime-auth.js",
    "lib/watcher.js"
  ]
}
