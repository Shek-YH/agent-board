{
  "root": true,
  "env": { "node": true, "es2022": true },
  "parserOptions": { "ecmaVersion": 2022, "sourceType": "script" },
  "ignorePatterns": ["node_modules/", "dist/", "runtime/"],
  "rules": {
    "no-undef": "error",
    "no-unreachable": "error",
    "no-dupe-keys": "error",
    "no-fallthrough": "error",
    "no-constant-condition": ["error", { "checkLoops": false }]
  }
}
